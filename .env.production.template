# VidGen Production Environment Template
# Copy to .env and fill in values before deploying.
# DO NOT commit .env to version control.

# ── GCP ────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=your-gcs-bucket-name

# ── Production gate (BOTH must be set to enable real generation) ────────────
FILM_MODE=production
ALLOW_REAL_GENERATION=true

# ── Models (defaults shown — override only if you have confirmed alternatives) ──
VEO_MODEL=veo-3.1-generate-001
DIRECTOR_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image
TTS_VOICE=en-US-Neural2-J

# ── Pipeline tuning ───────────────────────────────────────────────────────────
SHOTS_PER_SCENE=2
MAX_SHOTS=42
RETRY_ATTEMPTS=3
VEO_TIMEOUT_SECONDS=1800
IMAGE_REQUEST_DELAY_SECONDS=3.0
BURN_SUBTITLES=true

# ── Cloud Run ─────────────────────────────────────────────────────────────────
CLOUD_RUN_SERVICE=vidgen-api
CLOUD_RUN_JOB_NAME=vidgen-worker
SERVICE_ACCOUNT_EMAIL=vidgen-runner@your-gcp-project-id.iam.gserviceaccount.com

# ── Worker (set per-execution — do not commit a real value here) ───────────────
# VIDGEN_PROJECT_ID=<set by run_production_job.sh or Cloud Run Job override>
