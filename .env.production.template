# School of Sufi — copy to .env. Do not commit .env.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=your-gcs-bucket-name

# Both must be set before Gemini, Veo, or Cloud TTS run.
FILM_MODE=production
ALLOW_REAL_GENERATION=true

GEMINI_MODEL=gemini-2.5-flash
VEO_MODEL=veo-3.1-generate-001
TTS_VOICE=en-US-Neural2-D

MAX_VEO_CALLS=3
MAX_TTS_CALLS=2
MAX_GEMINI_CALLS=2
VEO_TIMEOUT_SECONDS=1800

# Optional. Privacy stays unlisted until you change it.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=unlisted
SOCIAL_WEBHOOK_URL=
NEY_BED_PATH=

CLOUD_RUN_SERVICE=vidgen-api
SERVICE_ACCOUNT_EMAIL=vidgen-runner@your-gcp-project-id.iam.gserviceaccount.com
